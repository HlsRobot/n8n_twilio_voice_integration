# N8N Twilio Voice Integration - Environment Variables
# Copy this file to .env and fill in your actual values

# Server Port
PORT=3001

# Twilio Configuration
# Get these from your Twilio console: https://console.twilio.com
ACCOUNT_SID=your_twilio_account_sid_here
AUTH_TOKEN=your_twilio_auth_token_here

# N8N Webhook Configuration
# Set this to your N8N webhook endpoint for processing voice prompts
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-workflow-path

# ngrok Configuration
# Use ngrok to tunnel your local server: ngrok http 3001
# Copy the forwarding domain here (without https://)
NGROK_DOMAIN=your-ngrok-domain.ngrok.io
